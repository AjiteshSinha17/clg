rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. USERS COLLECTION
    // Users who make ID or login back to the app
    match /users/{userId} {
      // Users can read their own profile and public profiles
      allow read: if isAuthenticated();
      // Users can create/update their own profile (including notificationPreferences, fcmTokens, etc.)
      allow create, update: if isOwner(userId);
      // Users cannot delete their profile (soft delete via isActive flag)
      allow delete: if false;

      // In-app notifications (push + in-app feed)
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        // Client should not create notifications; Cloud Functions (Admin SDK) bypasses rules.
        allow create, delete: if false;
        // Allow owner to mark as read (and only limited fields)
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'read',
            'readAt'
          ]);
      }
    }

    // 2. ROOMMATE_PROFILES COLLECTION
    // Who is finding roommate
    match /roommate_profiles/{profileId} {
      // Anyone authenticated can read roommate profiles
      allow read: if isAuthenticated();
      // Users can create/update their own roommate profile
      allow create, update: if isAuthenticated() && 
        (request.resource.data.userId == request.auth.uid || 
         resource == null || resource.data.userId == request.auth.uid);
      // Users can delete their own profile
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 3. COMMUNITY_CONTENT COLLECTION
    // Uploaded files/PDF URLs (notes and images) in community and people section
    match /community_content/{contentId} {
      // Anyone authenticated can read public and approved content
      allow read: if isAuthenticated() && 
        (resource.data.isPublic == true && resource.data.isApproved == true && resource.data.isActive == true) ||
        (isAuthenticated() && resource.data.authorId == request.auth.uid);
      
      // Users can create content
      allow create: if isAuthenticated() && 
        request.resource.data.authorId == request.auth.uid;
      
      // Users can update their own content
      allow update: if isAuthenticated() && 
        resource.data.authorId == request.auth.uid;
      
      // Users can soft delete their own content
      allow delete: if isAuthenticated() && 
        resource.data.authorId == request.auth.uid;
    }

    // Other collections (posts, chats, etc.) - keep existing rules
    // Personal 1:1 chats
    match /chats/{chatId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Community chat rooms (e.g. global)
    match /community_rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Community chat media (images/PDFs in community chat)
    match /community_media/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
    }

    // Personal chat media (images/PDFs in 1:1 chat)
    match /chat_media/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
    }
    
    // Personal message notifications (trigger for Render server)
    match /personal_message_notifications/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
    }

    // Posts (for community feed)
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }

    // Connection requests
    match /connection_requests/{requestId} {
      allow read, write: if isAuthenticated();
    }

    // Notification markers (used by Render server)
    match /notification_markers/{markerId} {
      allow read, write: if isAuthenticated();
    }
  }
}
